# App name shown in the UI. Override to personalise your instance.
VITE_APP_NAME=Initiative Tracker
VITE_APP_SHORT_NAME=IT

# Required for production. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-secret

# Used only when the database has no users. Change it after first login.
ADMIN_PASSWORD=change-this-on-first-run

# Optional local integrations. Leave blank to use the built-in defaults or disable
# the integration. Docker paths must exist inside the container.
AUDIO_SFX_DIR=
AUDIO_AMBIENCES_DIR=
FOUNDRY_DATA_PATH=

# D&D Beyond cobalt token for seeding the player library (npm run seed only).
SEED_DDB_COBALT=

# Optional lighting integrations. Values entered in Settings are stored in SQLite.
HUE_BRIDGE_IP=
HUE_USERNAME=
HA_URL=
HA_TOKEN=
